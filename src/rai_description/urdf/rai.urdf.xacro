<?xml version="1.0"?>
<robot name="rai" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_sim" default="false"/>
    <xacro:arg name="use_mock_hardware" default="false"/>

    <!-- Include generated urdf -->
    <xacro:include filename="$(find rai_description)/urdf/rai_geometry.urdf" />
    <xacro:include filename="$(find igvc_description)/control/bot.ros2_control.xacro" />

    <link name="world"/>

    <joint name="world_fixed" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <xacro:arm_macro id ="1"/>
    <xacro:arm_macro id ="2"/>
    <xacro:arm_macro id ="3"/>
    <xacro:arm_macro id ="4"/>
</robot>