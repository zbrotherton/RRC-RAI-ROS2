<?xml version="1.0"?>
<robot name="rai" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_sim" default="false"/>
    <xacro:arg name="use_mock_hardware" default="false"/>

    <!-- Include generated urdf -->
    <xacro:include filename="$(find rai_description)/urdf/rai_geometry.urdf" />
    <xacro:include filename="$(find rai_description)/urdf/rai.ros2_control.xacro" />

    <link name="world"/>

    <joint name="world_fixed" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <gazebo>
        <self_collide>true</self_collide>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find rai_control)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>