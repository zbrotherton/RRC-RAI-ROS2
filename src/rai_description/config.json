    "output_format": "urdf",
    "output_filename": "robot",
    "assets_directory": "meshes",

    "configuration": "default",
    "robot_name": "robot",

    "package_name": "rai_description",
    
    "set_zero_mass_to_fixed": true,

    "joint_properties": {
        "*": {
            "max_effort": 10.0,
            "max_velocity": 6.0,
            "friction": 0.5
        },
        "joint_name": {
            "max_effort": 20.0,
            "max_velocity": 10.0,
            "friction": 0.1,
            "limits": [0.5, 1.2]
        },
        "canvas_revolute": {
            "type": "continuous"
        }
    },
    
    "merge_stls": true,
    
    "simplify_stls": true,
    "max_stl_size": 3,

    "use_scads": true,
    "pure_shape_dilatation": 0.0,

    "add_dummy_base_link": true
}